# Admin connection used only by scripts/db.py to build the database.
# Leave empty to use the embedded PostgreSQL (pgserver) in .pgdata/.
DATABASE_URL=

# Password for the read-only analytics role. Generate your own; never commit .env.
BRICORAM_RO_PASSWORD=change-me

# DSN that Claude Code's MCP server uses. Read-only role ONLY.
BRICORAM_RO_DSN=postgresql://claude_analytics_ro:change-me@127.0.0.1:5432/bricoram
